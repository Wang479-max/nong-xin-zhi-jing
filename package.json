{
  "name": "nong-xin-zhi-jing",
  "private": true,
  "version": "1.0.0",
  "description": "农芯智境 - 智慧农业管理系统",
  "author": "Admin",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:frontend": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --packages=external --format=cjs --sourcemap --outfile=dist/server.cjs",
    "build:migrate": "esbuild server/saas/db/migrate.ts --bundle --platform=node --packages=external --format=esm --sourcemap --outfile=dist/migrate.mjs && tsx scripts/copyMigrations.ts server/saas/db/migrations dist/migrations",
    "verify:build-layout": "tsx scripts/verifyBuildLayout.ts dist",
    "build": "npm run build:frontend && npm run build:server && npm run build:migrate && npm run verify:build-layout",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/saas/db/migrate.ts",
    "db:migrate:prod": "node dist/migrate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
