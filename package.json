    "dotenv": "^17.2.3",
    "driver.js": "^1.4.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.4",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
