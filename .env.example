# 农芯智境 - 环境变量配置模板
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore，切勿提交真实密钥。

# 阿里云百炼视觉大模型 API Key (用于病虫害识别)
QWEN_API_KEY=your_qwen_api_key_here

# 智谱 AI API Key (用于农业专家诊断与多模态分析)
ZHIPU_AI_KEY=your_zhipu_api_key_here

# 端口配置 (如果不设置，系统将自动分配空闲端口)
PORT=3000

# 接口限流阈值：每个 IP 每分钟最大请求数 (默认 1200)
RATE_LIMIT_PER_MIN=1200
