# 农芯智境生产环境模板。复制为 .env，逐项填写；禁止提交 .env。
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
USER_DATA_PATH=/var/lib/nxzj
TRUST_PROXY=loopback

# PostgreSQL（Compose 会使用下列三项生成容器内 DATABASE_URL）
POSTGRES_DB=agri_saas
POSTGRES_USER=nxzj_app
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=8
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Redis（为缓存、限流和后续任务队列预留；Compose 会生成容器内 REDIS_URL）
REDIS_PASSWORD=
REDIS_URL=

# 邮箱验证码与 SMTP。SMTP_PASS 必须填写邮箱服务商的 SMTP 授权码，不是网页登录密码。
# QQ 邮箱示例
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# 163 邮箱可改为
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_SECURE=true
# HMAC 密钥使用 openssl rand -base64 48 独立生成。
EMAIL_VERIFICATION_HMAC_SECRET=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=农芯智境

# SaaS 会话。ACCESS_TOKEN_SECRET 请使用 `openssl rand -base64 48` 独立生成。
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SAAS_COOKIE_SECURE=true

# 首次启动的最高权限测试账号。生产上线后应立即更换密码并妥善保管。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 竞赛演示可用 mock；真实公开运营前必须改为 disabled，直至接入签名校验支付网关。
PAYMENT_MODE=disabled

# AI 服务密钥；不用对应能力时可留空。
QWEN_API_KEY=
ZHIPU_AI_KEY=

# 应用层限流
RATE_LIMIT_PER_MIN=1200
RATE_LIMIT_MAX_BUCKETS=10000
